// SPDX-License-Identifier: GPL-2.0-or-later
//
// The private interface between the radio HAL (shannond) and the ShannonIms
// ImsService app. Frozen as V1 (aidl_api/vendor.shannond.ims/1, .hash as the
// build computes it); a change needs V2: m vendor.shannond.ims-update-api,
// then m vendor.shannond.ims-freeze-api, and the users moved to -V2-.

aidl_interface {
    name: "vendor.shannond.ims",
    owner: "shannond",
    vendor_available: true,
    srcs: ["vendor/shannond/ims/*.aidl"],
    stability: "vintf",
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "system_current",
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: false,
        },
    },
}
